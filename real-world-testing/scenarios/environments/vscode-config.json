{
  "environment": "vscode",
  "name": "Visual Studio Code Configuration",
  "description": "VS Code development environment configuration for testing CodeAuthorityFirst",
  "setup": {
    "version": "1.0.0",
    "platforms": ["windows", "linux", "macos"],
    "required_tools": [
      "code",
      "git",
      "go",
      "opencode",
      "claude-code"
    ],
    "optional_tools": [
      "gopls"
    ]
  },
  "extensions": [
    {
      "id": "ms-vscode.go",
      "name": "Go",
      "version": "^0.39.0",
      "purpose": "Go language support"
    },
    {
      "id": "GitHub.copilot",
      "name": "GitHub Copilot",
      "version": "^1.58.0",
      "purpose": "AI pair programming"
    }
  ],
  "settings": {
    "go.lintTool": "golint",
    "go.lintOnSave": "file",
    "go.lintFlags": [
      "--fast"
    ],
    "go.formatTool": "gofmt",
    "go.formatOnSave": "file",
    "go.useCodeSnippetsOnFunctionSuggest": true,
    "go.useLanguageServer": true,
    "go.goplsEnv": {
      "GOFLAGS": "-mod=mod"
    },
    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "files.associations": {
      "*.go": "go"
    }
  },
  "workspace_setup": {
    "pre_commit_hook": {
      "enabled": true,
      "path": ".git/hooks/pre-commit",
      "command": "caf hook pre-commit --repo \"$(pwd)\""
    },
    "caf_configuration": {
      "auto_detect": true,
      "adapters": ["opencode", "claude-code"],
      "session_tracking": true,
      "performance_monitoring": true
    }
  },
  "testing_commands": {
    "initialize_caf": "caf init --auto-detect",
    "start_monitoring": "cd real-world-testing/scenarios && .\\start-monitoring.ps1",
    "run_session": "code .",
    "check_health": "caf doctor",
    "list_adapters": "caf adapters list",
    "view_dashboard": "caf dashboard"
  },
  "validation_scripts": [
    "scripts/validate-vscode-hooks.ps1",
    "scripts/validate-vscode-sessions.ps1",
    "scripts/validate-vscode-performance.ps1"
  ],
  "success_criteria": {
    "hook_execution": "100% success rate",
    "session_tracking": "Complete metadata collection",
    "performance": "<1 second hook execution",
    "compatibility": "No environment-specific errors"
  },
  "troubleshooting": {
    "common_issues": [
      {
        "issue": "Hook not firing",
        "solution": "Check VS Code terminal path and caf binary location"
      },
      {
        "issue": "Session not tracked",
        "solution": "Verify caf initialization and adapter configuration"
      },
      {
        "issue": "Performance issues",
        "solution": "Check gopls availability and system resources"
      }
    ]
  }
}