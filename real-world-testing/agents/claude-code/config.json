{
  "claude_code": {
    "name": "Claude Code Configuration",
    "version": "1.0.0",
    "tier": 1,
    "type": "native",
    "capabilities": {
      "pre_session": true,
      "post_edit": true,
      "pre_commit": true,
      "mcp": true
    }
  },
  "configuration": {
    "hooks": [
      {
        "event": "pre-session",
        "command": "caf hook pre-session"
      },
      {
        "event": "post-edit",
        "command": "caf hook post-edit"
      },
      {
        "event": "pre-commit",
        "command": "caf hook pre-commit"
      }
    ]
  }
}